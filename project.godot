; Engine configuration file.
; Gods & Liars — 72h MVP
config_version=5

[application]
config/name="Gods & Liars"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
Steamworks="*res://autoload/steamworks.gd"
NetworkManager="*res://autoload/network_manager.gd"
VoiceChat="*res://autoload/voice_chat.gd"
GameManager="*res://autoload/game_manager.gd"
MatchAuthority="*res://autoload/match_authority.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[input]
voice_talk={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":86,"unicode":118)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
