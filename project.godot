; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value

config_version=5

[application]

config/name="Gods & Liars"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Steamworks="*res://autoload/steamworks.gd"
PartyManager="*res://autoload/party_manager.gd"
NetworkManager="*res://autoload/network_manager.gd"
MatchmakingManager="*res://autoload/matchmaking_manager.gd"
InputBindings="*res://autoload/input_bindings.gd"
AudioSettings="*res://autoload/audio_settings.gd"
VoiceChat="*res://autoload/voice_chat.gd"
GameManager="*res://autoload/game_manager.gd"
MatchAuthority="*res://autoload/practice_match_authority.gd"
PracticeManager="*res://autoload/practice_manager.gd"
PresentationFeedback="*res://autoload/presentation_feedback.gd"
HostMigrationManager="*res://autoload/practice_host_migration_manager.gd"
HostMigrationTransport="*res://autoload/host_migration_transport.gd"
HostMigrationReconnect="*res://autoload/host_migration_reconnect.gd"
HostMigrationRestore="*res://autoload/host_migration_restore.gd"
HostMigrationFallback="*res://autoload/host_migration_fallback.gd"
MatchLeaveManager="*res://autoload/match_leave_manager.gd"
QAEventLog="*res://autoload/qa_event_log.gd"
VideoSettings="*res://autoload/video_settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/Tripo3d_Godot_Bridge/plugin.cfg")

[input]

voice_talk={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":16,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":86,"key_label":0,"unicode":118,"location":0,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
limits/opengl/max_lights_per_object=16

[tripo_bridge]

last_cleanup="2026-09-05T00:18:11"
